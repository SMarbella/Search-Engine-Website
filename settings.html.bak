<html lang="en">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KnowsMore - Isn't that interesting?</title>
    <link rel="icon" href="https://knowsmore.wordpress.com/wp-content/uploads/2025/05/knowsmore-eyes-closed-e1748183789645.png"
      sizes="16x16">
    <link rel="stylesheet" href="/css/pure/pure-min.css">
    <link rel="stylesheet" href="/css/pure/grids-responsive-min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/layouts/marketing/styles.css">
    <link rel="stylesheet" href="css/app.css">
  </head>
  <body>
    <!-- Header menu -->
    <div class="navbar"> <a href="index.html"> </a>
      <div class="brand"><a href="index.html"> </a><a href="/Search-Engine-Website/index.html">
          <img src="images/headerlogo.png" alt="Brand Logo"> </a> </div>
      <a href="/Search-Engine-Website/email.html">
        <p>email</p>
      </a> <a href="/Search-Engine-Website/faq.html">
        <p>FAQ</p>
      </a> <a href="/Search-Engine-Website/accounts.html">
        <p>accounts</p>
      </a> <a href="/Search-Engine-Website/update.html">
        <p>update</p>
      </a> <a href="/Search-Engine-Website/whats-new.html">
        <p>what’s new?</p>
      </a> </div>
    <!-- Main content -->
    <main style="flex: 1;">
      <div class="main-content">
        <!-- Left-aligned image inside the container --> <a href="index.html">
          <img src="images/powered%20by%20knowsmore.png" alt="KnowsMore" class="logo-img">
        </a>
        <!-- Article Body Section -->
        <div class="container">
          <h1>Settings</h1>
          <!-- Personal Info -->
          <section>
            <h2>Personal Info</h2>
            <label for="username">Username</label> <input id="username" placeholder="e.g. knowsmore_user"
              type="text"> <label for="email">Email</label> <input id="email"
              placeholder="e.g. user@example.com" type="email"> </section>
          <!-- Preferences -->
          <section>
            <h2>Preferences</h2>
            <div class="toggle-group"> <input id="darkMode" type="checkbox"> <label
                for="darkMode">Enable Dark Mode</label> </div>
            <div class="toggle-group"> <input id="autocomplete" checked="checked"
                type="checkbox"> <label for="autocomplete">Enable Autocomplete
                in Search</label> </div>
            <label for="language">Preferred Language</label>
            <select id="language">
              <option value="en">English</option>
              <option value="es">Español</option>
              <option value="fr">Français</option>
              <option value="de">Deutsch</option>
            </select>
          </section>
          <!-- Privacy -->
          <section>
            <h2>Privacy</h2>
            <div class="toggle-group"> <input id="saveHistory" type="checkbox">
              <label for="saveHistory">Save Search History</label> </div>
            <div class="toggle-group"> <input id="personalizedAds" type="checkbox">
              <label for="personalizedAds">Show Personalized Ads</label> </div>
          </section>
          <button class="btn-save" onclick="alert('Settings saved!')">Save
            Settings</button> </div>
      </div>
    </main>
    <strong>
      <!-- Footer -->
      <footer class="footer">
        <div class="footer-links"> <a class="active" href="/Search-Engine-Website/privacy.html">Privacy</a>
          <a href="/Search-Engine-Website/terms.html">Terms</a> <a href="/Search-Engine-Website/settings.html">Settings</a>
        </div>
      </footer>
    </strong>
  </body>
</html>
